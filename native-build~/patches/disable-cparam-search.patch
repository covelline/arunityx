         ARLOGe("Unable to initialise cparamSearch.\n");
         goto bail;
     };
+#endif
 
     // Initial state.
     vid->pixelFormat = AR_PIXEL_FORMAT_INVALID;
@@ -752,9 +754,11 @@ bail2:
 bail1:
     pthread_mutex_destroy(&vid->frameLock);
     free(vid->device_id);
+#if USE_CPARAM_SEARCH
     if (cparamSearchFinal() < 0) {
         ARLOGe("Unable to finalise cparamSearch.\n");
