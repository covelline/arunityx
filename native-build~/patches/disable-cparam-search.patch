+#endif
 bail:
     free(vid);
     vid = NULL;
@@ -807,10 +811,11 @@ int ar2VideoCloseAndroid(AR2VideoParamAndroidT *vid)
 	pthread_mutex_destroy(&(vid->frameLock));
     free(vid->name);
     free(vid->device_id);
+#if USE_CPARAM_SEARCH
     if (cparamSearchFinal() < 0) {
         ARLOGe("Unable to finalise cparamSearch.\n");
